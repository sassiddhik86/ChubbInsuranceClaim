    <Content Remove="src\Domain\Exceptions\**" />
    <EmbeddedResource Remove="src\Domain\Constants\**" />
    <EmbeddedResource Remove="src\Domain\Exceptions\**" />
    <None Remove="src\Domain\Constants\**" />
    <None Remove="src\Domain\Exceptions\**" />
  </ItemGroup>

